# Copy to .env and fill in. NEVER commit a filled-in .env.
# ---- Interpretation model (REQUIRED for a submittable service) ----
# One of: anthropic | sleepyai | placeholder
LLM_PROVIDER=anthropic
# Model identifier for the chosen provider.
LLM_MODEL=
# API key for the chosen provider. Supplied at runtime only; never baked into an image.
LLM_API_KEY=
# Required only for sleepyai. The documented OpenAI-compatible base URL is:
# https://www.sleepyai.org/api/v1
LLM_BASE_URL=
# ---- Service ----
PORT=8000
LOG_LEVEL=INFO
# Absolute per-request deadline in seconds (judge cuts at 30s).
REQUEST_DEADLINE_S=25
# Dev escape hatch ONLY. Allows LLM_PROVIDER=placeholder, which returns all-no_op
# and is NOT a valid competition configuration. Must be false for submission.
ALLOW_STUB_INTERPRETER=false
